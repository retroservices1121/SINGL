generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Event {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  subtitle     String?
  emoji        String?
  color        String?
  imageUrl     String?
  searchTerms  String[]
  contentTerms String[]  @default([])
  volume       Float?
  liquidity    Float?
  openInterest Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  markets    Market[]
  newsItems  NewsItem[]
  xPosts     XPost[]
  videos     Video[]
  tiktoks    TikTok[]
}

model Market {
  id             String   @id @default(cuid())
  eventId        String
  event          Event    @relation(fields: [eventId], references: [id])
  ticker         String
  title          String
  yesPrice       Float
  noPrice        Float
  volume         Float?
  change24h      Float?
  category       String?
  rulesPrimary   String?
  closeTime      DateTime?
  expirationTime DateTime?
  venueMarketId  String?
  yesOutcomeId   String?
  noOutcomeId    String?
  venue          String?
  tickSize       String   @default("0.01")
  outcomeName    String?
  outcome2Name   String?
  ogImageUrl     String?
  updatedAt      DateTime @updatedAt
}

model NewsItem {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id])
  title     String
  summary   String
  source    String
  sentiment String
  time      String
  url       String?
  fetchedAt DateTime @default(now())
}

model XPost {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id])
  name      String
  handle    String
  text      String
  time      String
  likes     String?
  retweets  String?
  tweetId   String?  @unique
  fetchedAt DateTime @default(now())
}

model Video {
  id         String   @id @default(cuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id])
  title      String
  channel    String
  youtubeUrl String
  youtubeId  String?
  duration   String?
  views      String?
  thumbnail  String?
  fetchedAt  DateTime @default(now())
}

model TikTok {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id])
  videoId   String?  @unique
  username  String
  caption   String
  thumbnail String?
  videoUrl  String
  likes     String?
  views     String?
  fetchedAt DateTime @default(now())
}

model SiteConfig {
  id    String @id @default("singleton")
  key   String @unique
  value String
}

model RedeemedAccessCode {
  code       String   @id
  redeemedAt DateTime @default(now())
}

model AggAccount {
  id            String   @id @default(cuid())
  aggUserId     String   @unique
  walletAddress String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model UserProfile {
  id              String   @id @default(cuid())
  aggUserId       String   @unique
  walletAddress   String?
  displayName     String?
  avatarUrl       String?
  twitterHandle   String?
  twitterId       String?
  twitterAvatar   String?
  referralCode    String   @unique
  referredBy      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([walletAddress])
  @@index([referralCode])
  @@index([referredBy])
}
