# AGG Markets (docs.agg.market)
NEXT_PUBLIC_AGG_APP_ID=
NEXT_PUBLIC_AGG_BASE_URL=https://api.agg.market
NEXT_PUBLIC_AGG_WS_URL=wss://ws.agg.market/ws
NEXT_PUBLIC_AGG_AUTH_REDIRECT=http://localhost:3000/auth/callback
AGG_SERVER_API_KEY=

# Optional: comma-separated AGG category ids to scope /venue-events
# queries to. AGG 500s the listing endpoint when most category presets
# are disabled on the app config; passing the enabled ones avoids that.
# Look these up via `/api/health/agg` once and paste them here.
AGG_DEFAULT_CATEGORY_IDS=

# Early-access gate: comma-separated single-use codes from AGG.
# Each code unlocks one browser, then burns in the DB.
AGG_ACCESS_CODES=

# Optional: WalletConnect project id (for wagmi connector used by AGG SIWE)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Virtuals Protocol GAME
VIRTUALS_API_KEY=
VIRTUALS_AGENT_ID=
GAME_TWITTER_ACCESS_TOKEN=       # From: virtuals-tweepy auth -k <GAME_API_KEY>

# YouTube
YOUTUBE_API_KEY=

# Database (Railway Postgres)
DATABASE_URL=

# Cron secret (Railway cron auth)
CRON_SECRET=

# SPREDD Oracle — Base RPC for reading SPRDD balances (hold-to-multiply).
# Optional: falls back to the public https://mainnet.base.org node. Use an
# Alchemy/Infura Base URL in production to avoid public-node rate limits.
BASE_RPC_URL=

# SPREDD Oracle reward distributor — the buyback/hot wallet that holds the
# bought-back SPRDD and pays out claims. Fund it with the SPRDD acquired by the
# daily buyback + a little ETH on Base for gas. If unset, claims are disabled
# (the UI shows "claims open once funded" and balances keep accruing).
# NEVER commit a real key. Server-only; do not prefix NEXT_PUBLIC_.
DISTRIBUTOR_PRIVATE_KEY=

# Oracle cron schedule (point Railway cron / external scheduler at these):
#   every ~20 min on match days -> GET /api/cron/oracle-settle?secret=$CRON_SECRET
#   daily ~05:00 ET             -> GET /api/cron/oracle-rewards?secret=$CRON_SECRET
# After each day's buyback fills, record it (distributes SPRDD pro-rata):
#   POST /api/cron/oracle-rewards { periodKey, sprddBought, buybackTx }
